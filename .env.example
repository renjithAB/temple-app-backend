# Server Environment
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=1
RUN_JOBS=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/temple_platform?schema=public"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/temple_platform?schema=public"

# Tokens & Cryptography
# Note: For Ed25519 JWT, provide raw Ed25519 PEM / JWK or use generated key pair
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="temple-platform"
JWT_AUDIENCE="temple-platform-clients"
OTP_HMAC_SECRET="dev-otp-hmac-secret-at-least-32-chars-long!"
QR_SIGNING_SECRET="dev-qr-signing-secret-at-least-32-chars-long!"

# Email Integration (console or brevo)
EMAIL_PROVIDER=console
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=""
BREVO_SMTP_KEY=""
EMAIL_FROM="noreply@templeplatform.org"

# Image Storage (Cloudinary)
CLOUDINARY_URL=""

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVICE_ACCOUNT_JSON=""

# Monitoring
SENTRY_DSN=""

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:19006"
